<Window x:Class="DashTweaks.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DashTweaks - Optimizador Seguro para Windows Gaming" 
        Height="910" Width="1040"
        MinHeight="760" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="#121316"
        Foreground="#EDEDED"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Estilo Botón Genérico Más Redondeado y Elegante -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#383842"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.90"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo TabItem Moderno -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9E9EA6"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Margin="0,0,10,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#0078D4"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Header -->
            <RowDefinition Height="Auto"/> <!-- Row 1: Global Backup / Restore Actions -->
            <RowDefinition Height="Auto"/> <!-- Row 2: Auto-Game Mode Quick Toggle Card -->
            <RowDefinition Height="Auto"/> <!-- Row 3: Status / Progress Alert Bar -->
            <RowDefinition Height="*"/>    <!-- Row 4: Main Tabs -->
            <RowDefinition Height="Auto"/> <!-- Row 5: Console Activity Log (Expander) -->
        </Grid.RowDefinitions>

        <!-- Header Principal -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DashTweaks" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <Border Background="#1C2E42" BorderBrush="#2A4A6D" BorderThickness="1" CornerRadius="6" Margin="12,0,0,0" Padding="8,3">
                        <TextBlock Text="v2.3 • Ultimate Gaming Suite" FontSize="11" Foreground="#60CDFF" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Optimizador de rendimiento seguro para Windows 10/11 • Cero cajas negras • Backup First" 
                           FontSize="12" Foreground="#8F8F96" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnCheckUpdates" 
                        Content="🔄 Buscar Actualizaciones" 
                        Style="{StaticResource ActionButtonStyle}" 
                        Background="#242630" 
                        BorderBrush="#383C4D"
                        FontSize="11.5"
                        Padding="14,7"
                        Margin="0,0,10,0"
                        Click="BtnCheckUpdates_Click"/>

                <Border Background="#1A281C" BorderBrush="#274A2A" BorderThickness="1" CornerRadius="8" Padding="12,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛡️" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Mitigaciones Seguras (HVCI/VBS protegidas)" FontSize="11.5" Foreground="#6CCB76" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Global Backup / Restore Actions -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card Crear Backup Manual -->
            <Border Grid.Column="0" Background="#18191E" BorderBrush="#2A2A33" BorderThickness="1" CornerRadius="10" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="Punto de Control Completo" FontSize="13.5" Foreground="#60CDFF" FontWeight="SemiBold"/>
                        <TextBlock Text="Crea un punto de restauración, vuelca ramas del registro y esquema de energía." 
                                   FontSize="11.5" Foreground="#858590" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" 
                            x:Name="BtnCreateBackup" 
                            Content="CREAR BACKUP" 
                            Style="{StaticResource ActionButtonStyle}" 
                            Background="#0066B8" 
                            Padding="16,10"
                            Click="BtnCreateBackup_Click"/>
                </Grid>
            </Border>

            <!-- Card Restaurar Manual -->
            <Border Grid.Column="2" Background="#18191E" BorderBrush="#2A2A33" BorderThickness="1" CornerRadius="10" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="Restauración Total" FontSize="13.5" Foreground="#F59E0B" FontWeight="SemiBold"/>
                        <TextBlock Text="Importa el registro y reactiva el plan de energía del checkpoint previo." 
                                   FontSize="11.5" Foreground="#858590" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" 
                            x:Name="BtnRestoreBackup" 
                            Content="RESTAURAR (RESET)" 
                            Style="{StaticResource ActionButtonStyle}" 
                            Background="#8A3414" 
                            Padding="16,10"
                            Click="BtnRestoreBackup_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Auto-Game Mode Quick Toggle Card -->
        <Border Grid.Row="2" Background="#151A24" BorderBrush="#223046" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <DockPanel>
                <CheckBox x:Name="ChkAutoGameMode" 
                          Content="🟢 Activar Game Mode Automáticamente al abrir juegos" 
                          FontSize="13" 
                          FontWeight="SemiBold" 
                          Foreground="#60CDFF" 
                          VerticalAlignment="Center"
                          DockPanel.Dock="Left"
                          Checked="ChkAutoGameMode_Changed"
                          Unchecked="ChkAutoGameMode_Changed"/>

                <TextBlock Text="(Aplica Energía, MMCSS y suspende apps secundarias sin tocar tu lista blanca; revierte al salir)" 
                           FontSize="11.5" Foreground="#7E94B3" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>

        <!-- Status / Progress Alert Bar (Visible during operations) -->
        <Border Grid.Row="3" x:Name="BusyBanner" Background="#232014" BorderBrush="#594611" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⏳" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="TxtBusyStatus" Text="Procesando operación en segundo plano..." FontSize="12.5" Foreground="#F0CD68" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="2" IsIndeterminate="True" Width="130" Height="6" Background="#383017" Foreground="#F59E0B" BorderThickness="0" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Navigation Tabs -->
        <TabControl Grid.Row="4" Background="Transparent" BorderThickness="0" Margin="0,0,0,10">
            
            <!-- PESTAÑA 1: TWEAKS DEL SISTEMA (19 TWEAKS) -->
            <TabItem Header="🚀 Optimizaciones (19)">
                <Border Background="#16171B" BorderBrush="#25262E" BorderThickness="1" CornerRadius="10" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header + Search -->
                            <RowDefinition Height="Auto"/> <!-- Dashboard Métricas CPU/RAM + Perfil -->
                            <RowDefinition Height="*"/>    <!-- Tweaks Scroll List -->
                        </Grid.RowDefinitions>

                        <!-- Header Superior y Buscador Minimalista -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                <TextBlock Text="Catálogo de Rendimiento Gaming" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                <Border Background="#1F2128" BorderBrush="#2C303D" BorderThickness="1" CornerRadius="10" Padding="8,4" Margin="12,0,0,0"
                                        ToolTip="El primer cambio crea un punto de restauración automático para que siempre puedas revertir con seguridad."
                                        Cursor="Help">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🛡️" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="Protección con Checkpoint activa" FontSize="11" Foreground="#8F9BB3" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Buscador Minimalista -->
                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                    Background="#141519" BorderBrush="#2A2B33" BorderThickness="1" CornerRadius="8" Padding="10,6" MinWidth="240">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#7A7A88" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1">
                                        <TextBox x:Name="TxtSearchTweaks" 
                                                 Background="Transparent" 
                                                 Foreground="#FFFFFF" 
                                                 BorderThickness="0" 
                                                 FontSize="12" 
                                                 VerticalAlignment="Center"
                                                 CaretBrush="#FFFFFF"
                                                 TextChanged="TxtSearchTweaks_TextChanged"/>
                                        <TextBlock x:Name="TxtSearchPlaceholder" 
                                                   Text="Buscar optimización..." 
                                                   FontSize="12" 
                                                   Foreground="#686874" 
                                                   IsHitTestVisible="False" 
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DockPanel>

                        <!-- Dashboard de Métricas en Tiempo Real y Perfil Recomendado -->
                        <Border Grid.Row="1" Background="#1A1B22" BorderBrush="#282935" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Indicador CPU: Texto izquierda, barra derecha -->
                                <Grid Grid.Column="0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="🖥️ CPU" FontSize="11" Foreground="#8E8E98" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtCpuUsage" Text="0.0 %" FontSize="13" Foreground="#60CDFF" FontWeight="Bold" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <ProgressBar Grid.Column="1" x:Name="PbCpuUsage" Height="7" Minimum="0" Maximum="100" Value="0" 
                                                 Background="#252630" Foreground="#0078D4" BorderThickness="0" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Indicador RAM: Texto izquierda, barra derecha -->
                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="🧠 RAM" FontSize="11" Foreground="#8E8E98" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtRamUsage" Text="0 % (0 MB / 0 MB)" FontSize="12.5" Foreground="#6CCB76" FontWeight="Bold" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <ProgressBar Grid.Column="1" x:Name="PbRamUsage" Height="7" Minimum="0" Maximum="100" Value="0" 
                                                 Background="#252630" Foreground="#107C10" BorderThickness="0" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Indicador Estado de Red (NIC Tuning) -->
                                <Border Grid.Column="4" Background="#14151B" BorderBrush="#252632" BorderThickness="1" CornerRadius="8" Padding="12,7" VerticalAlignment="Center">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🌐 Latencia de Red" FontSize="10.5" Foreground="#8E8E98" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtNetworkStatus" Text="Estándar (Default)" FontSize="11.5" Foreground="#8E8E98" FontWeight="Bold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Botón Perfil Recomendado -->
                                <Button Grid.Column="6" 
                                        x:Name="BtnApplyRecommendedProfile" 
                                        Content="⚡ APLICAR PERFIL RECOMENDADO" 
                                        Style="{StaticResource ActionButtonStyle}" 
                                        Background="#107C10" 
                                        Padding="16,10"
                                        VerticalAlignment="Center"
                                        Click="BtnApplyRecommendedProfile_Click"/>
                            </Grid>
                        </Border>

                        <!-- Lista de Tweaks con Tarjetas Amplias y Textos Humanos -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TweaksItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1C1D22" BorderBrush="#2A2A32" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Info del Tweak -->
                                                <StackPanel Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Center">
                                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,10,2"/>
                                                        
                                                        <Border Background="#25262E" BorderBrush="#32333E" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Category}" FontSize="10.5" Foreground="#9DA3B4" FontWeight="SemiBold"/>
                                                        </Border>

                                                        <Border Background="{Binding RiskBadgeBackground}" CornerRadius="6" Padding="8,3" Margin="0,0,8,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Risk}" FontSize="10.5" Foreground="#FFFFFF" FontWeight="Bold"/>
                                                        </Border>

                                                        <Border Background="{Binding StatusBadgeBackground}" CornerRadius="6" Padding="8,3" Margin="0,0,8,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="10.5" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                                        </Border>

                                                        <Border Background="#3D220B" BorderBrush="#6B3C14" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,0,2" VerticalAlignment="Center"
                                                                Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVisConverter}}">
                                                            <TextBlock Text="⚠️ Requiere Reinicio" FontSize="10.5" Foreground="#FBBF24" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </WrapPanel>

                                                    <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="#9E9EA8" TextWrapping="Wrap" LineHeight="19" Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <!-- Botón Acción Redondeado y con Margen -->
                                                <Button Grid.Column="1" 
                                                        Content="{Binding ActionButtonText}" 
                                                        Background="{Binding ActionButtonBackground}" 
                                                        IsEnabled="{Binding CanExecute}"
                                                        Style="{StaticResource ActionButtonStyle}" 
                                                        MinWidth="120"
                                                        Height="38"
                                                        Margin="14,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Click="TweakActionButton_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>

            <!-- PESTAÑA 2: DIAGNÓSTICO DE RED PARA GAMING -->
            <TabItem Header="🩺 Diagnóstico de Red">
                <Border Background="#16171B" BorderBrush="#25262E" BorderThickness="1" CornerRadius="10" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Header de Diagnóstico -->
                            <DockPanel Margin="0,0,0,16">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Centro de Diagnóstico de Red para Gaming" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Analiza la estabilidad real de tu conexión midiendo Packet Loss, Jitter y Bufferbloat bajo descarga para erradicar el lag." 
                                               FontSize="12" Foreground="#8F8F96" Margin="0,3,0,0"/>
                                </StackPanel>

                                <Button x:Name="BtnRunDiagnostics" 
                                        Content="🔬 EJECUTAR DIAGNÓSTICO COMPLETO" 
                                        Style="{StaticResource ActionButtonStyle}" 
                                        Background="#0078D4" 
                                        DockPanel.Dock="Right" 
                                        HorizontalAlignment="Right" 
                                        VerticalAlignment="Center"
                                        Padding="16,10"
                                        Click="BtnRunDiagnostics_Click"/>
                            </DockPanel>

                            <!-- Tarjetas de Semáforo de Métricas -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Tarjeta 1: Packet Loss -->
                                <Border Grid.Column="0" x:Name="CardPacketLoss" Background="#1C1D22" BorderBrush="#2A2A32" BorderThickness="1" CornerRadius="10" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="Pérdida de Paquetes" FontSize="11.5" Foreground="#8E8E98" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtPacketLossVal" Text="-- %" FontSize="20" FontWeight="Bold" Foreground="#F3F3F3" Margin="0,6,0,6"/>
                                        <Border x:Name="BadgePacketLoss" Background="#24242A" BorderBrush="#383842" BorderThickness="1" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock x:Name="TxtPacketLossStatus" Text="Sin testear" FontSize="10.5" Foreground="#A0A0AA" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Tarjeta 2: Jitter -->
                                <Border Grid.Column="2" x:Name="CardJitter" Background="#1C1D22" BorderBrush="#2A2A32" BorderThickness="1" CornerRadius="10" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="Jitter (Fluctuación)" FontSize="11.5" Foreground="#8E8E98" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtJitterVal" Text="-- ms" FontSize="20" FontWeight="Bold" Foreground="#F3F3F3" Margin="0,6,0,6"/>
                                        <Border x:Name="BadgeJitter" Background="#24242A" BorderBrush="#383842" BorderThickness="1" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock x:Name="TxtJitterStatus" Text="Sin testear" FontSize="10.5" Foreground="#A0A0AA" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Tarjeta 3: Bufferbloat -->
                                <Border Grid.Column="4" x:Name="CardBufferbloat" Background="#1C1D22" BorderBrush="#2A2A32" BorderThickness="1" CornerRadius="10" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="Bufferbloat (+ms bajo carga)" FontSize="11.5" Foreground="#8E8E98" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtBufferbloatVal" Text="-- ms" FontSize="20" FontWeight="Bold" Foreground="#F3F3F3" Margin="0,6,0,6"/>
                                        <Border x:Name="BadgeBufferbloat" Background="#24242A" BorderBrush="#383842" BorderThickness="1" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock x:Name="TxtBufferbloatStatus" Text="Sin testear" FontSize="10.5" Foreground="#A0A0AA" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Tarjeta 4: Latencia Base -->
                                <Border Grid.Column="6" x:Name="CardLatency" Background="#1C1D22" BorderBrush="#2A2A32" BorderThickness="1" CornerRadius="10" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="Latencia Base (Ping)" FontSize="11.5" Foreground="#8E8E98" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtLatencyVal" Text="-- ms" FontSize="20" FontWeight="Bold" Foreground="#60CDFF" Margin="0,6,0,6"/>
                                        <Border x:Name="BadgeLatency" Background="#1E2B3A" BorderBrush="#2B4666" BorderThickness="1" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock x:Name="TxtLatencyStatus" Text="Sin testear" FontSize="10.5" Foreground="#60CDFF" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Panel de Recomendaciones Inteligentes -->
                            <Border Background="#16171C" BorderBrush="#2A2C38" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="💡" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Diagnóstico y Recomendaciones Personalizadas" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Border Background="#1B1C22" BorderBrush="#262730" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                        <TextBlock x:Name="TxtRecommendations" 
                                                   Text="Presiona 'EJECUTAR DIAGNÓSTICO COMPLETO' para analizar el estado de tu red y obtener recomendaciones dirigidas." 
                                                   FontSize="12.5" Foreground="#C0C0C8" TextWrapping="Wrap" LineHeight="20"/>
                                    </Border>

                                    <!-- Acción Recomendada: Limpiar Ruta de Red -->
                                    <Border Background="#1D2028" BorderBrush="#2C354A" BorderThickness="1" CornerRadius="8" Padding="14">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                                <TextBlock Text="🛠️ Acción Recomendada: Limpiar y Restablecer Ruta de Red" FontSize="13" FontWeight="Bold" Foreground="#60CDFF"/>
                                                <TextBlock Text="Limpia la caché de resolución DNS de Windows y renueva las rutas de paquetes para resolver micro-cortes." 
                                                           FontSize="11.5" Foreground="#8E9CB3" Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <Button x:Name="BtnFlushDnsAndReset" 
                                                    Content="LIMPIAR RUTA DE RED" 
                                                    Style="{StaticResource ActionButtonStyle}" 
                                                    Background="#107C10" 
                                                    DockPanel.Dock="Right" 
                                                    HorizontalAlignment="Right" 
                                                    VerticalAlignment="Center"
                                                    Click="BtnFlushDnsAndReset_Click"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- PESTAÑA 3: GESTOR DE SERVICIOS -->
            <TabItem Header="⚙️ Servicios">
                <Border Background="#16171B" BorderBrush="#25262E" BorderThickness="1" CornerRadius="10" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="Control Seguro de Servicios Secundarios" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Detén y deshabilita telemetría, indexación y precargas pesadas para prevenir tirones y uso innecesario de disco/CPU durante juegos. El estado original se preserva en memoria." 
                                       FontSize="12" Foreground="#8F8F96" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ServicesItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1C1D22" BorderBrush="#2A2A32" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="Bold" Foreground="#F0F0F0"/>
                                                        <TextBlock Text="{Binding ServiceName, StringFormat='({0})'}" FontSize="11" Foreground="#7E7E88" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="#95959E" TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="14,0,0,0">
                                                    <Border Background="{Binding StatusBackground}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding StartTypeText}" Foreground="{Binding StartTypeColor}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="2" Background="#161619" BorderBrush="#26262B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <Button x:Name="BtnDisableServices" 
                                            Content="DESHABILITAR SELECCIONADOS" 
                                            Style="{StaticResource ActionButtonStyle}" 
                                            Background="#8A3414" 
                                            Margin="0,0,10,0"
                                            Click="BtnDisableServices_Click"/>

                                    <Button x:Name="BtnRestoreServices" 
                                            Content="RESTAURAR SERVICIOS ORIGINALES" 
                                            Style="{StaticResource ActionButtonStyle}" 
                                            Background="#0066B8" 
                                            Margin="0,0,10,0"
                                            Click="BtnRestoreServices_Click"/>
                                </StackPanel>

                                <Button x:Name="BtnRefreshServices" 
                                        Content="🔄 ACTUALIZAR ESTADO" 
                                        Style="{StaticResource ActionButtonStyle}" 
                                        Background="#2B2B32" 
                                        DockPanel.Dock="Right" 
                                        HorizontalAlignment="Right"
                                        Click="BtnRefreshServices_Click"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- PESTAÑA 4: GAME MODE (EXCLUSIONES) -->
            <TabItem Header="🎮 Exclusiones">
                <Border Background="#16171B" BorderBrush="#25262E" BorderThickness="1" CornerRadius="10" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="Lista Blanca de Aplicaciones en Game Mode" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Selecciona qué procesos activos NO deben suspenderse al activar la optimización (ej. Discord para chat de voz, navegadores para guías). La selección se guarda en %LOCALAPPDATA%\DashTweaks\config.json." 
                                       FontSize="12" Foreground="#8F8F96" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Grid.Row="1" Background="#161619" BorderBrush="#26262B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="🔍 Filtrar proceso:" VerticalAlignment="Center" FontSize="12.5" Foreground="#A0A0A8" Margin="0,0,10,0"/>

                                <TextBox Grid.Column="1" 
                                         x:Name="TxtSearchProcess" 
                                         Background="#202025" 
                                         Foreground="#FFFFFF" 
                                         BorderBrush="#383842" 
                                         BorderThickness="1" 
                                         Padding="8,6" 
                                         FontSize="12" 
                                         VerticalAlignment="Center"
                                         Margin="0,0,14,0"
                                         TextChanged="TxtSearchProcess_TextChanged"/>

                                <Button Grid.Column="2" 
                                         x:Name="BtnRefreshProcesses" 
                                         Content="🔄 ACTUALIZAR PROCESOS" 
                                         Style="{StaticResource ActionButtonStyle}" 
                                         Background="#2B2B32" 
                                         Margin="0,0,10,0"
                                         Click="BtnRefreshProcesses_Click"/>

                                <Button Grid.Column="3" 
                                         x:Name="BtnSaveWhitelist" 
                                         Content="💾 GUARDAR LISTA BLANCA" 
                                         Style="{StaticResource ActionButtonStyle}" 
                                         Background="#0066B8" 
                                         Click="BtnSaveWhitelist_Click"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ProcessesItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1C1D22" BorderBrush="#2A2A32" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsWhitelisted}" VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <TextBlock Text="No tocar al jugar" FontSize="12" Foreground="#D0D0D8"/>
                                                </CheckBox>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ExeName}" FontSize="13" FontWeight="Bold" Foreground="#60CDFF"/>
                                                        <TextBlock Text="{Binding ProcessId, StringFormat='(PID: {0})'}" FontSize="11" Foreground="#7A7A85" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding MainWindowTitle}" FontSize="11.5" Foreground="#95959E" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <Border Grid.Column="2" Background="{Binding StatusBadgeBackground}" BorderBrush="{Binding StatusBadgeBorder}" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>

            <!-- PESTAÑA 5: BLOATWARE (APPS UWP) -->
            <TabItem Header="🧹 Bloatware">
                <Border Background="#16171B" BorderBrush="#25262E" BorderThickness="1" CornerRadius="10" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Desinstalador Seguro de Aplicaciones Preinstaladas de Windows" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Elimina paquetes secundarios UWP para liberar espacio, reducir procesos de fondo y eliminar telemetría innecesaria. Totalmente reversible." 
                                       FontSize="12" Foreground="#8F8F96" Margin="0,3,0,8" TextWrapping="Wrap"/>

                            <Border Background="#1B281E" BorderBrush="#2B5230" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛡️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Reversibilidad Garantizada: Las aplicaciones desinstaladas se pueden volver a instalar desde la Microsoft Store con un solo clic." 
                                               FontSize="11.5" Foreground="#6CCB76" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#2B2414" BorderBrush="#594419" BorderThickness="1" CornerRadius="8" Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠️" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Nota: Desinstalar la app de Xbox puede afectar al inicio de sesión de Xbox Game Pass. Restáurala si es necesario." 
                                               FontSize="11" Foreground="#F59E0B" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="BloatwareItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1C1D22" BorderBrush="#2A2A32" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="Bold" Foreground="#F0F0F0"/>
                                                        <TextBlock Text="{Binding PackageName, StringFormat='({0})'}" FontSize="11" Foreground="#7E7E88" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="#95959E" TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <Border Grid.Column="2" Background="{Binding StatusBackground}" BorderBrush="{Binding StatusBorder}" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="14,0,0,0">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="2" Background="#161619" BorderBrush="#26262B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <Button x:Name="BtnUninstallBloatware" 
                                            Content="DESINSTALAR SELECCIONADOS" 
                                            Style="{StaticResource ActionButtonStyle}" 
                                            Background="#8A3414" 
                                            Margin="0,0,10,0"
                                            Click="BtnUninstallBloatware_Click"/>

                                    <Button x:Name="BtnRestoreBloatware" 
                                            Content="RESTAURAR SELECCIONADOS (vía Store)" 
                                            Style="{StaticResource ActionButtonStyle}" 
                                            Background="#0066B8" 
                                            Margin="0,0,10,0"
                                            Click="BtnRestoreBloatware_Click"/>
                                </StackPanel>

                                <Button x:Name="BtnRefreshBloatware" 
                                        Content="🔄 ACTUALIZAR LISTA" 
                                        Style="{StaticResource ActionButtonStyle}" 
                                        Background="#2B2B32" 
                                        DockPanel.Dock="Right" 
                                        HorizontalAlignment="Right"
                                        Click="BtnRefreshBloatware_Click"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- PESTAÑA 6: INICIO RÁPIDO (STARTUP MANAGER) -->
            <TabItem Header="⚡ Inicio Rápido">
                <Border Background="#16171B" BorderBrush="#25262E" BorderThickness="1" CornerRadius="10" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header & Refresh -->
                            <RowDefinition Height="*"/>    <!-- Items List -->
                            <RowDefinition Height="Auto"/> <!-- Information Note -->
                        </Grid.RowDefinitions>

                        <!-- Header y Botón Refrescar -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Gestor de Aplicaciones de Inicio (Startup)" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Desactivar aplicaciones innecesarias al inicio mejora el tiempo de arranque y libera memoria RAM." 
                                           FontSize="12" Foreground="#8F8F96" Margin="0,3,0,0"/>
                            </StackPanel>

                            <Button x:Name="BtnRefreshStartup" 
                                    Content="🔄 ACTUALIZAR LISTA" 
                                    Style="{StaticResource ActionButtonStyle}" 
                                    Background="#2B2B32" 
                                    DockPanel.Dock="Right" 
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Center"
                                    Click="BtnRefreshStartup_Click"/>
                        </DockPanel>

                        <!-- Lista de Aplicaciones de Inicio -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="StartupItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1C1D22" BorderBrush="#2A2A32" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- CheckBox de Activación/Desactivación -->
                                                <CheckBox Grid.Column="0" 
                                                          IsChecked="{Binding IsEnabled}" 
                                                          IsEnabled="{Binding CanToggle}" 
                                                          VerticalAlignment="Center" 
                                                          Margin="0,0,14,0"
                                                          Click="StartupCheckBox_Click"/>

                                                <!-- Detalle del Elemento -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Bold" Foreground="#F0F0F0"/>

                                                        <!-- Badge de Ubicación -->
                                                        <Border Background="{Binding LocationBackground}" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding LocationTypeText}" Foreground="{Binding LocationColor}" FontSize="10.5" FontWeight="SemiBold"/>
                                                        </Border>

                                                        <!-- Salvaguarda: Advertencia de aplicación crítica -->
                                                        <Border Background="#3D1814" BorderBrush="#6B2820" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding IsCritical, Converter={StaticResource BoolToVisConverter}}">
                                                            <TextBlock Text="{Binding CriticalWarningText}" Foreground="#FF6B5E" FontSize="10.5" FontWeight="Bold"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Comando / Ruta de Ejecución -->
                                                    <TextBlock Text="{Binding Command}" FontSize="11" Foreground="#7E7E88" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Badge de Estado -->
                                                <Border Grid.Column="2" Background="{Binding StatusBackground}" BorderBrush="{Binding StatusBorder}" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="14,0,0,0">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Salvaguarda: Aclaración en la Interfaz -->
                        <Border Grid.Row="2" Background="#18181D" BorderBrush="#26262F" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,12,0,0">
                            <TextBlock Text="Nota: Los cambios se aplicarán en el próximo reinicio del sistema. Si la aplicación ya está abierta, no se cerrará en este momento." 
                                       FontSize="11.5" Foreground="#A0A0AA" FontStyle="Italic"/>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Consola de Actividad Colapsable (TAREA 4) -->
        <Expander Grid.Row="5" 
                  x:Name="ConsoleExpander"
                  IsExpanded="False"
                  Background="#15161A" 
                  BorderBrush="#25262E" 
                  BorderThickness="1" 
                  Margin="0,6,0,0">
            <Expander.Style>
                <Style TargetType="Expander">
                    <Setter Property="Foreground" Value="#8A8A96"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="11.5"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Expander">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header Row -->
                                        <ToggleButton Grid.Row="0"
                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Cursor="Hand"
                                                      Padding="14,8">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock x:Name="Arrow" Text="▶" Foreground="#7A7A88" FontSize="10" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Arrow" Property="Text" Value="▼"/>
                                                            <Setter TargetName="Arrow" Property="Foreground" Value="#60CDFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                            <ContentPresenter ContentSource="Header"/>
                                        </ToggleButton>

                                        <!-- Expandable Content -->
                                        <Border Grid.Row="1" x:Name="ExpandSite" 
                                                Visibility="Collapsed" 
                                                Background="#111215" 
                                                BorderBrush="#1F2026" 
                                                BorderThickness="0,1,0,0" 
                                                CornerRadius="0,0,8,8"
                                                Padding="12,10">
                                            <ContentPresenter/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsExpanded" Value="True">
                                        <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Expander.Style>

            <Expander.Header>
                <DockPanel HorizontalAlignment="Stretch">
                    <TextBlock Text="📟 Registro de Actividad y Consola" FontSize="11.5" FontWeight="SemiBold" Foreground="#8A8A96" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="20,0,0,0">
                        <TextBlock Text="Estado:" FontSize="11" Foreground="#656570" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatus" Text="Listo" FontSize="11.5" Foreground="#60CDFF" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Expander.Header>

            <ScrollViewer x:Name="LogScrollViewer" Height="110" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="TxtLog" 
                         Background="Transparent" 
                         Foreground="#C8C8D0" 
                         BorderThickness="0" 
                         IsReadOnly="True" 
                         FontFamily="Consolas, Cascadia Code, monospace" 
                         FontSize="11.5" 
                         TextWrapping="Wrap"/>
            </ScrollViewer>
        </Expander>
    </Grid>
</Window>
