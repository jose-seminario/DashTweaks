<Window x:Class="DashTweaks.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DashTweaks - Optimizador Seguro para Gaming" 
        Height="620" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#181818"
        Foreground="#EDEDED"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Estilo Botón Principal de Acción -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Info Banner -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
            <RowDefinition Height="*"/>    <!-- Activity Log -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="DashTweaks" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="Optimización para Windows 10/11 enfocada en gaming • Cero cajas negras • Backup First" 
                       FontSize="13" Foreground="#9E9E9E" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Safety Card Banner -->
        <Border Grid.Row="1" Background="#222225" BorderBrush="#2F2F35" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🛡️" FontSize="22" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Protocolo de Seguridad Activo" FontWeight="SemiBold" FontSize="14" Foreground="#E0E0E0"/>
                    <TextBlock Text="Antes de aplicar tweaks, genera un punto de control. Todo cambio es reversible y no se vulneran mitigaciones del sistema." 
                               FontSize="12" Foreground="#8C8C93" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Action Cards (Buttons) -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card Crear Backup -->
            <Border Grid.Column="0" Background="#202023" BorderBrush="#333338" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="1. Punto de Control" FontSize="13" Foreground="#0078D4" FontWeight="SemiBold"/>
                    <TextBlock Text="Crea un punto de restauración del sistema, exporta ramas clave del registro y guarda el esquema de energía actual." 
                               FontSize="12" Foreground="#A0A0A0" Margin="0,4,0,14" TextWrapping="Wrap" MinHeight="36"/>
                    <Button x:Name="BtnCreateBackup" 
                            Content="CREAR BACKUP (Checkpoint)" 
                            Style="{StaticResource ActionButtonStyle}" 
                            Background="#0066B8" 
                            Click="BtnCreateBackup_Click"/>
                </StackPanel>
            </Border>

            <!-- Card Restaurar -->
            <Border Grid.Column="2" Background="#202023" BorderBrush="#333338" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="2. Rollback Total" FontSize="13" Foreground="#E88B00" FontWeight="SemiBold"/>
                    <TextBlock Text="Restaura el estado previo del sistema importando las claves del registro y reactivando el plan de energía original." 
                               FontSize="12" Foreground="#A0A0A0" Margin="0,4,0,14" TextWrapping="Wrap" MinHeight="36"/>
                    <Button x:Name="BtnRestoreBackup" 
                            Content="RESTAURAR (RESET)" 
                            Style="{StaticResource ActionButtonStyle}" 
                            Background="#8A3B14" 
                            Click="BtnRestoreBackup_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Activity Log Console -->
        <Border Grid.Row="3" Background="#161618" BorderBrush="#2A2A2E" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Registro de Actividad" FontWeight="SemiBold" FontSize="12" Foreground="#808080" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="TxtStatus" Text="Listo" FontSize="12" Foreground="#60CDFF" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                </DockPanel>

                <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="TxtLog" 
                             Background="Transparent" 
                             Foreground="#C8C8C8" 
                             BorderThickness="0" 
                             IsReadOnly="True" 
                             FontFamily="Consolas, Courier New, monospace" 
                             FontSize="12" 
                             TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
